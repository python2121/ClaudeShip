<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hub speaks plain http on loopback and the tailnet; ATS would
	     otherwise refuse both without a word. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.python21.ClaudeShip</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>claudeship</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Claude Ship talks to the session hub on your Mac over your Tailscale network.</string>
	<!-- Pairing: the QR code `claudeship hub link` prints on the Mac. -->
	<key>NSCameraUsageDescription</key>
	<string>Claude Ship scans the pairing QR code shown on your Mac.</string>
</dict>
</plist>
